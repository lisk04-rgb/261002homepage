# 사이트 실제 주소 (sitemap, 공유 미리보기에 사용). 끝에 / 없이
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정 및 구성 → "구성"의 값을 복사)
# 아래 값이 비어 있으면 로그인·찜·회원 후기·통계 기능이 숨겨지고 나머지 사이트는 정상 동작합니다.
# 웹용 공개 식별자라 브라우저에 노출되어도 괜찮습니다(보안은 firestore.rules가 담당).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google Analytics를 켰다면 G-로 시작하는 값 (없으면 통계 기능만 꺼짐)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
